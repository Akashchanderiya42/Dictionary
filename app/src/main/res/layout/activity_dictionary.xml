<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
     android:background="#F8F9FA"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Dictionary">

    <ImageView
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_200sdp"
        android:src="@drawable/inground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_100sdp"
        app:constraintSet="@color/cardview_shadow_end_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible"
        android:id="@+id/inImage"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp"
        android:background="@drawable/background2"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="-20dp" />

    <TextView
        android:id="@+id/txt_dic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inknut"
        android:text="Dictionary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/_23ssp"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="#333333" />

    <TextView
        android:id="@+id/txt_dic1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inknut"
        android:text="Type a Word"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/_23ssp"
        app:layout_constraintTop_toBottomOf="@id/txt_dic"
        android:textColor="#333333" />

    <LinearLayout
        android:id="@+id/Liner1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:weightSum="2"
        android:elevation="6dp"
        android:layout_marginHorizontal="25dp"
        android:background="@drawable/search_border"
        app:layout_constraintTop_toBottomOf="@id/txt_dic1">

    <EditText
        android:id="@+id/search_input"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Search....."
        android:textColorHint="@color/black"
        android:textStyle="bold"
        android:background="@drawable/search_border"
        android:layout_weight="1.5"
        android:layout_gravity="center"
        android:padding="10dp"
        android:textSize="20sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/txt_dic1"/>

    <ImageView
        android:id="@+id/mic1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/search_input"
        app:layout_constraintTop_toBottomOf="@id/txt_dic1"
        android:layout_gravity="center"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/mic"/>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/search_btn"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/button"
        android:text="Search"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Liner1" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/Liner1"
        android:indeterminateTint="#1976D2"
        android:id="@+id/progress_bar"
        android:visibility="gone"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="word"
        android:textSize="@dimen/_25ssp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/Liner1"
        android:layout_margin="10dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="#1565C0"
        android:id="@+id/word_textview"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="/t e s t/"
        app:layout_constraintTop_toBottomOf="@id/word_textview"
        android:layout_marginStart="10dp"
        android:textSize="15sp"
        android:textColor="#030821"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/phonetic_textview"/>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/meaning_recycler_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/phonetic_textview" />

</androidx.constraintlayout.widget.ConstraintLayout>